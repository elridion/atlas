diff --git a/src/Ink/InkPainter.Scratch.cs b/src/Ink/InkPainter.Scratch.cs
new file mode 100644
index 0000000..1a7e7ab
--- /dev/null
+++ b/src/Ink/InkPainter.Scratch.cs
@@ -0,0 +1,131 @@
+using System;
+using System.Collections.Generic;
+
+namespace Atlas
+{
+    internal sealed partial class InkPainter
+    {
+        /// <summary>
+        /// The large working arrays of one paint (masks, flood-fill queues, distance-field
+        /// buffers, the canvas's planes), lent out and given back as its stages finish, so a later
+        /// stage reuses an earlier one's instead of allocating its own. Under Valheim's Mono every
+        /// large allocation can start a stop-the-world collection of the whole heap (100-160 ms
+        /// with the game loaded), and a first paint used to allocate about 900 MB.
+        /// The sheet-sized byte planes a repaint needs again (SpareSheets) are kept for the
+        /// session and lent to the next paint, until ClearGroundwork; the rest is dropped with
+        /// the painter. Only arrays nothing outlives the paint with go back: never the kept
+        /// groundwork's (Groundwork), the record's or the returned sheet. A lent array may hold
+        /// an earlier stage's values unless asked for cleared. Not thread-safe: lent and given back
+        /// only between a painter's stages, never inside its parallel loops.
+        /// </summary>
+        private sealed class Scratch
+        {
+            private readonly List<byte[]> m_bytes = new List<byte[]>();
+            private readonly List<bool[]> m_bools = new List<bool[]>();
+            private readonly List<int[]> m_ints = new List<int[]>();
+            private readonly List<float[]> m_floats = new List<float[]>();
+            // The session pool's serial when this paint began: a paint still running for a world
+            // the player left keeps its arrays out of the next world's pool.
+            private readonly int m_serial;
+
+            public Scratch()
+            {
+                lock (s_spareLock) m_serial = s_spareSerial;
+            }
+
+            public byte[] Bytes(int length, bool clear)
+            {
+                byte[] array = Take(m_bytes, length);
+                if (array == null && length == CanvasSize * CanvasSize)
+                    lock (s_spareLock)
+                        if (m_serial == s_spareSerial) array = Take(s_spareSheets, length);
+                if (array == null) return new byte[length];
+                if (clear) Array.Clear(array, 0, length);
+                return array;
+            }
+
+            public bool[] Bools(int length, bool clear)
+            {
+                bool[] array = Take(m_bools, length);
+                if (array == null) return new bool[length];
+                if (clear) Array.Clear(array, 0, length);
+                return array;
+            }
+
+            // Never cleared: every caller writes before it reads.
+            public int[] Ints(int length) => Take(m_ints, length) ?? new int[length];
+
+            public float[] Floats(int length) => Take(m_floats, length) ?? new float[length];
+
+            public void Give(byte[] array)
+            {
+                if (array != null) m_bytes.Add(array);
+            }
+
+            public void Give(bool[] array)
+            {
+                if (array != null) m_bools.Add(array);
+            }
+
+            public void Give(int[] array)
+            {
+                if (array != null) m_ints.Add(array);
+            }
+
+            public void Give(float[] array)
+            {
+                if (array != null) m_floats.Add(array);
+            }
+
+            // Once the paint is done: up to SpareSheets sheet-sized byte planes wait for the next
+            // paint; everything else is dropped.
+            public void KeepForNextPaint()
+            {
+                lock (s_spareLock)
+                {
+                    if (m_serial != s_spareSerial) return;
+                    foreach (byte[] array in m_bytes)
+                        if (array.Length == CanvasSize * CanvasSize && s_spareSheets.Count < SpareSheets) s_spareSheets.Add(array);
+                }
+                m_bytes.Clear();
+                m_bools.Clear();
+                m_ints.Clear();
+                m_floats.Clear();
+            }
+
+            private static T[] Take<T>(List<T[]> list, int length)
+            {
+                for (int i = list.Count - 1; i >= 0; i--)
+                {
+                    T[] array = list[i];
+                    if (array.Length != length) continue;
+                    list[i] = list[list.Count - 1];
+                    list.RemoveAt(list.Count - 1);
+                    return array;
+                }
+                return null;
+            }
+        }
+
+        // The sheet-sized planes a repaint takes again: the canvas's six, the land, sea and wood
+        // masks, the wide lakes, lake tiers and line land, and the river courses. About 208 MB
+        // kept between paints.
+        private const int SpareSheets = 13;
+
+        private static readonly object s_spareLock = new object();
+        private static readonly List<byte[]> s_spareSheets = new List<byte[]>();
+        private static int s_spareSerial;
+
+        // Drops the planes kept for the next paint, when the player leaves the world.
+        private static void ClearSpares()
+        {
+            lock (s_spareLock)
+            {
+                s_spareSheets.Clear();
+                s_spareSerial++;
+            }
+        }
+
+        private readonly Scratch m_scratch = new Scratch();
+    }
+}
